# ─── Required ───────────────────────────────────────────────────────────────
# Token from @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Who may use the bot: Telegram user IDs separated by commas.
# Find yours by messaging @userinfobot (or just message your bot: it replies with your ID).
ALLOWED_USER_IDS=123456789,987654321

# From https://my.telegram.org → "API development tools".
# Used by the local Bot API server so the bot can send files up to 2 GB.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# ─── Optional ───────────────────────────────────────────────────────────────
# Largest file the bot will send, in MB (max 2000 with the local server, 50 without).
# MAX_FILE_SIZE_MB=2000

# How many downloads may run at the same time (for all users together).
# MAX_CONCURRENT_DOWNLOADS=2

# Netscape-format cookies file, for age-restricted videos or when YouTube
# asks the server to "confirm you're not a bot". Put it in ./data/cookies.txt
# COOKIES_FILE=/app/data/cookies.txt

# Send all downloads through a proxy, for when TikTok, Instagram or YouTube block the server's IP.
# Formats: http://host:port or socks5://user:password@host:port
# PROXY_URL=socks5://user:password@proxy.example.com:1080

# Update yt-dlp every time the container starts (recommended).
# YTDLP_AUTO_UPDATE=true

# DEBUG, INFO, WARNING or ERROR
# LOG_LEVEL=INFO

# Only for running WITHOUT Docker. Docker Compose sets these for you.
# TELEGRAM_API_URL=http://localhost:8081
# DOWNLOAD_DIR=downloads
